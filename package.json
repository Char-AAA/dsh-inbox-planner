{
  "name": "dsh-inbox-planner",
  "version": "0.3.1",
  "description": "邮件 → 待办 → 日历 三合一：自带待办和月历面板（标题栏有刷新图标），自动读取 dsh-email 的新邮件，判断是否需要你处理，把事项连同日期时间写进待办；判重、冲突提示、语言跟随系统。All-in-one mail → to-do → calendar: built-in to-do and month-calendar panel with a refresh icon; new mail that needs your action becomes dated to-dos, with dedupe and clash warnings.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "vendor/LICENSE.dsh-sidebar-todo"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "email",
    "inbox",
    "todo",
    "calendar",
    "productivity",
    "imap"
  ],
  "author": "Charles <hanzeyu0123@gmail.com> (https://github.com/Char-AAA)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Char-AAA/dsh-inbox-planner.git"
  },
  "homepage": "https://github.com/Char-AAA/dsh-inbox-planner#readme",
  "bugs": {
    "url": "https://github.com/Char-AAA/dsh-inbox-planner/issues"
  },
  "icon": "./icon.svg",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs --check && node --test test/*.test.js",
    "prepack": "node scripts/build-client.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "dsh-sidebar-todo": "^0.3.1",
    "jsdom": "^25.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
