{
  "name": "dsh-inbox-planner",
  "version": "0.4.0",
  "description": "邮件 → 待办 → 日历 三合一：自动读取 dsh-email 的新邮件，判断是否需要你处理，把事项连同日期时间写进自带的待办和月历；会议邀请直读、改期和取消自动跟进、到点提醒和每日简报、多邮箱判重与冲突提示。All-in-one mail → to-do → calendar for DSH: dated to-dos from new mail, .ics invitations read directly, reschedules and cancellations followed, reminders and a daily brief, multi-mailbox dedupe and clash warnings.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "lib/**/*.js",
    "vendor/LICENSE.dsh-sidebar-todo"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "email",
    "inbox",
    "todo",
    "calendar",
    "productivity",
    "imap",
    "ics",
    "reminder"
  ],
  "author": "Charles <hanzeyu0123@gmail.com> (https://github.com/Char-AAA)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Char-AAA/dsh-inbox-planner.git"
  },
  "homepage": "https://github.com/Char-AAA/dsh-inbox-planner#readme",
  "bugs": {
    "url": "https://github.com/Char-AAA/dsh-inbox-planner/issues"
  },
  "icon": "./icon.svg",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs --check && node --test test/*.test.js",
    "prepack": "node scripts/build-client.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "dsh-sidebar-todo": "^0.3.1",
    "jsdom": "^25.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
